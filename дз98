
#include <iostream>
#include <vector>
using namespace std;

// Функція додає новий стовпець 
void addColumn(vector<vector<int>>& matrix, int pos, const vector<int>& newCol) {
    for (int i = 0; i < matrix.size(); i++) {
        matrix[i].insert(matrix[i].begin() + pos, newCol[i]);
    }
}

int main() {
    vector<vector<int>> matrix = {
        {1,2,3},
        {4,5,6},
        {7,8,9}
    };

    cout << "Початкова матриця:\n";
    for (auto& row : matrix) {
        for (int v : row) cout << v << " ";
        cout << endl;
    }

    addColumn(matrix, 1, { 10,20,30 });

    cout << "\nПісля додавання стовпця:\n";
    for (auto& row : matrix) {
        for (int v : row) cout << v << " ";
        cout << endl;
    }
    return 0;
}
