#include <iostream>
#include <string>
using namespace std;

int main() {
    const int SIZE = 10; // 10 контактів
    string names[SIZE];
    string phones[SIZE];
    int count = 0; // кількість контактів

    int choice;
    do {
        cout << "\n1. Додати контакт\n2. Пошук за ім’ям\n3. Пошук за телефоном\n4. Вихід\nВаш вибір: ";
        cin >> choice;

        if (choice == 1) {
            if (count < SIZE) {
                cout << "Введіть ім’я: ";
                cin >> names[count];
                cout << "Введіть телефон: ";
                cin >> phones[count];
                count++;
            }
            else {
                cout << "Телефонна книга заповнена!\n";
            }
        }
        else if (choice == 2) {
            string name;
            cout << "Введіть ім’я: ";
            cin >> name;
            bool found = false;
            for (int i = 0; i < count; i++) {
                if (names[i] == name) {
                    cout << "Телефон: " << phones[i] << endl;
                    found = true;
                }
            }
            if (!found) cout << "Не знайдено!\n";
        }
        else if (choice == 3) {
            string phone;
            cout << "Введіть телефон: ";
            cin >> phone;
            bool found = false;
            for (int i = 0; i < count; i++) {
                if (phones[i] == phone) {
                    cout << "Ім’я: " << names[i] << endl;
                    found = true;
                }
            }
            if (!found) cout << "Не знайдено!\n";
        }
    } while (choice != 4);

    return 0;
}



#include <iostream>
#include <string>
using namespace std;

int main() {
    const int N = 5;
    string students[N];

    cout << "Введіть 5 прізвищ:\n";
    for (int i = 0; i < N; i++) {
        cin >> students[i];
    }

    // просте сортування (бульбашкою)
    for (int i = 0; i < N - 1; i++) {
        for (int j = 0; j < N - i - 1; j++) {
            if (students[j] > students[j + 1]) {
                string temp = students[j];
                students[j] = students[j + 1];
                students[j + 1] = temp;
            }
        }
    }

    cout << "\nВідсортовані прізвища:\n";
    for (int i = 0; i < N; i++) {
        cout << students[i] << endl;
    }

    return 0;
}
