#include <iostream>
using namespace std;

int main() {
    const int M = 2; // рядки
    const int N = 3; // стовпці
    int matrix[M][N] = {
        {1, 2, 3},
        {4, 5, 6}
    };

    cout << "Початкова матриця:\n";
    for (int i = 0; i < M; i++) {
        for (int j = 0; j < N; j++) {
            cout << matrix[i][j] << " ";
        }
        cout << endl;
    }

    cout << "\nТранспонована матриця:\n";
    for (int j = 0; j < N; j++) {
        for (int i = 0; i < M; i++) {
            cout << matrix[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}

